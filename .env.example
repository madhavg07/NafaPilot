# Copy this file to .env (in this same folder) and fill in values.
# .env is git-ignored. Never commit it, paste it into chat, or put keys in frontend code.

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://nafapilot:nafapilot@localhost:5432/nafapilot
CORS_ORIGINS=http://localhost:3000
# Synthetic dataset folder; leave empty for <project root>/data/synthetic
DATA_DIR=

# --- LLM ---
# One provider, or a comma-separated chain tried in order (the next is used only if one fails):
#   sarvam,gemini = Sarvam first, Gemini automatically if Sarvam fails (recommended)
#   gemini        = Gemini only
#   mock          = deterministic, offline, no key (used by automated tests)
LLM_PROVIDER=sarvam,gemini

# Sarvam AI (https://dashboard.sarvam.ai). Models: sarvam-105b, glm5.3, gemma4, ...
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# none | low | high | max. "low" keeps answers fast and cheap; leave empty if the model rejects it.
SARVAM_REASONING_EFFORT=low

# Gemini (https://aistudio.google.com/app/apikey). Check models with:
#   python ../scripts/check_llm.py --provider gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=8192

# --- Postgres container (docker-compose.yml) ---
POSTGRES_USER=nafapilot
POSTGRES_PASSWORD=nafapilot
POSTGRES_DB=nafapilot

# --- Frontend (put this in frontend/.env.local, not here) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
